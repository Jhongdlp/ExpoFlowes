# Postgres (servicio db)
POSTGRES_USER=expoflores
POSTGRES_PASSWORD=expoflores
POSTGRES_DB=expoflores

# Backend
DATABASE_URL=postgresql+psycopg://expoflores:expoflores@db:5432/expoflores
SECRET_KEY=cambiar-en-produccion-usar-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# Seed: credenciales del admin demo (documentadas en README)
SEED_ADMIN_EMAIL=admin@expoflores.demo
SEED_ADMIN_PASSWORD=Admin123!
# Clave del representante de demostracion (solo el del primer expositor del seed)
SEED_REP_PASSWORD=Demo1234!

# Correo (Mailtrap). SMTP_HOST vacio = correo simulado escrito en el log estructurado,
# que es el fallback que el enunciado admite. Con inbox sandbox de Mailtrap:
#   SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525  SMTP_USER=...  SMTP_PASSWORD=...
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@expoflores.demo
# Solo demo: devuelve el enlace de set-password en la respuesta del alta de expositor.
EXPOSE_SETUP_LINK=false

# Puerto del host para la BD (5432 por defecto; cambialo si ya tienes postgres local)
DB_PORT=5432
LOGIN_RATE_LIMIT=5/minute

# Frontend: URL de la API que consume el navegador (vacio = mismo origen, via proxy)
VITE_API_URL=/api/v1
