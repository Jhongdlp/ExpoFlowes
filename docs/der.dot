digraph DER {
  rankdir=LR;
  graph [fontname="Helvetica", bgcolor="white", nodesep=0.4, ranksep=1.0, splines=spline];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9, color="#444444"];

  events [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#1f4e79" colspan="2"><font color="white"><b>events</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">UQ</td><td align="left">slug</td></tr>
      <tr><td align="left"></td><td align="left">name, year</td></tr>
      <tr><td align="left"></td><td align="left">starts_on, ends_on</td></tr>
      <tr><td align="left"></td><td align="left">is_active</td></tr>
    </table>>];

  stand_size_rules [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>stand_size_rules</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left"></td><td align="left">label</td></tr>
      <tr><td align="left"></td><td align="left">min_m2, max_m2</td></tr>
      <tr><td align="left" colspan="2"><i>UQ(event_id, label)</i></td></tr>
    </table>>];

  credential_rules [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>credential_rules</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left"></td><td align="left">category</td></tr>
      <tr><td align="left"></td><td align="left">credentials_per_block</td></tr>
      <tr><td align="left"></td><td align="left">block_m2</td></tr>
      <tr><td align="left"></td><td align="left">rounding_mode</td></tr>
      <tr><td align="left" colspan="2"><i>UQ(event_id, category)</i></td></tr>
    </table>>];

  exhibitors [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#1f4e79" colspan="2"><font color="white"><b>exhibitors</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left"></td><td align="left">tax_id, tax_id_type</td></tr>
      <tr><td align="left"></td><td align="left">legal_name, stand_name</td></tr>
      <tr><td align="left"></td><td align="left">address</td></tr>
      <tr><td align="left"></td><td align="left">requested_m2</td></tr>
      <tr><td align="left"></td><td align="left">deleted_at</td></tr>
      <tr><td align="left" colspan="2"><i>UQ(event_id, tax_id)<br/>WHERE deleted_at IS NULL</i></td></tr>
    </table>>];

  representatives [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#1f4e79" colspan="2"><font color="white"><b>representatives</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left">FK UQ</td><td align="left">exhibitor_id</td></tr>
      <tr><td align="left"></td><td align="left">full_name</td></tr>
      <tr><td align="left"></td><td align="left">identification(_type)</td></tr>
      <tr><td align="left"></td><td align="left">email, phone, position</td></tr>
    </table>>];

  exhibitor_contacts [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#1f4e79" colspan="2"><font color="white"><b>exhibitor_contacts</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left">FK</td><td align="left">exhibitor_id</td></tr>
      <tr><td align="left"></td><td align="left">name, phone, email</td></tr>
    </table>>];

  users [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#b26500" colspan="2"><font color="white"><b>users</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left">FK</td><td align="left">exhibitor_id (NULL = admin)</td></tr>
      <tr><td align="left"></td><td align="left">email</td></tr>
      <tr><td align="left"></td><td align="left">password_hash (NULL)</td></tr>
      <tr><td align="left"></td><td align="left">role, is_active</td></tr>
      <tr><td align="left" colspan="2"><i>UQ(event_id, email)</i></td></tr>
    </table>>];

  password_setup_tokens [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#b26500" colspan="2"><font color="white"><b>password_setup_tokens</b></font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">user_id</td></tr>
      <tr><td align="left">UQ</td><td align="left">token_hash</td></tr>
      <tr><td align="left"></td><td align="left">expires_at, used_at</td></tr>
    </table>>];

  participants [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
      <tr><td bgcolor="#7b1fa2" colspan="2"><font color="white"><b>participants</b> (1 fila = 1 credencial)</font></td></tr>
      <tr><td align="left">PK</td><td align="left">id</td></tr>
      <tr><td align="left">FK</td><td align="left">event_id</td></tr>
      <tr><td align="left">FK</td><td align="left">exhibitor_id</td></tr>
      <tr><td align="left"></td><td align="left">first_name, last_name</td></tr>
      <tr><td align="left"></td><td align="left">identification(_type)</td></tr>
      <tr><td align="left"></td><td align="left">phone, position</td></tr>
      <tr><td align="left"></td><td align="left">category</td></tr>
      <tr><td align="left"></td><td align="left">provider_company (NULL)</td></tr>
      <tr><td align="left"></td><td align="left">email (NULL)</td></tr>
      <tr><td align="left"></td><td align="left">credential_notified_at</td></tr>
      <tr><td align="left" colspan="2"><i>UQ(event_id, identification)<br/>CHECK (category='Service') = (provider_company IS NOT NULL)</i></td></tr>
    </table>>];

  events -> stand_size_rules     [label="1..N"];
  events -> credential_rules     [label="1..N"];
  events -> exhibitors           [label="1..N"];
  events -> users                [label="1..N"];
  events -> participants         [label="1..N"];
  exhibitors -> representatives     [label="1..1"];
  exhibitors -> exhibitor_contacts  [label="1..N (min 1)"];
  exhibitors -> users               [label="1..1"];
  exhibitors -> participants        [label="1..N"];
  users -> password_setup_tokens    [label="1..N"];

  nota [shape=note, fillcolor="#fff9c4", style=filled, fontsize=9, label=<
    <table border="0" cellspacing="0" cellpadding="2">
      <tr><td align="left"><b>No existen</b> columnas de cuota ni de categoria de stand:</td></tr>
      <tr><td align="left">ambas son derivadas del metraje y de las tablas de reglas</td></tr>
      <tr><td align="left">(CLAUDE.md §6.4, §6.7).</td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left"><b>event_id en toda tabla operativa</b>: el aislamiento entre</td></tr>
      <tr><td align="left">ferias es requisito, no adorno (§7.1).</td></tr>
    </table>>];
}
